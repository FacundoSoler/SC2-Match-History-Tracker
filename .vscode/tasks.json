{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "PowerShell",
      "type": "shell",
      "command": "powershell",
      "isBackground": true,
      "presentation": {
        "group": "dev-layout"
      }
    },
    {
      "label": "NodeJS Server",
      "type": "shell",
      "command": "npm run dev:server",
      "isBackground": true,
      "presentation": {
        "group": "dev-layout"
      }
    },
    {
      "label": "Tests",
      "type": "shell",
      "command": "npm run test:watch",
      "isBackground": true,
      "presentation": {
        "group": "dev-layout"
      }
    },
    {
      "label": "Launch Dev Terminals",
      "dependsOn": [
        "PowerShell",
        "NodeJS Server",
        "Tests"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "runOptions": {
        "runOn": "folderOpen"
      }
    }
  ]
}