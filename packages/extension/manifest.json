{
  "manifest_version": 3,
  "name": "SC2 Match History Tracker Companion",
  "version": "1.0.0",
  "description": "Bypasses CORS to fetch live match data from the local StarCraft II client API.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://localhost:6119/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:5173/*", 
        "https://sc2-match-history-tracker-production.up.railway.app/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "externally_connectable": {
    "matches": ["http://localhost:5173/*"]
  },
  "action": {
    "default_popup": "popup.html"
  }
}