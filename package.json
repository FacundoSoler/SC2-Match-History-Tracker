{
  "name": "sc2pulse-viewer-monorepo",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=packages/web",
    "dev:server": "npm run dev --workspace=packages/server",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspace=packages/web",
    "test:watch": "npm run test:watch --workspace=packages/web"
  }
}